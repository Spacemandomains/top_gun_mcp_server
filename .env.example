# Stripe — payment processing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PAYMENT_URL=https://buy.stripe.com/...          # $1.50 full audit
STRIPE_QUICK_CHECK_PAYMENT_URL=https://buy.stripe.com/... # $0.50 quick check

# Search APIs (at least one required for full audits)
BRAVE_SEARCH_API_KEY=BSA...
EXA_API_KEY=...

# USDC wallet for on-chain payment display
USDC_WALLET_ADDRESS=0x...

# Optional: Base URL of your deployed API (used by MCP when calling remote)
TOP_GUN_API_URL=https://your-app.vercel.app

# x402 v2 gate (api/v1 endpoints)
# CDP keys settle through Coinbase (required for Bazaar cataloging).
# Without them, X402_FACILITATOR_URL is used (default: PayAI public facilitator).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
